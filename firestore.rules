
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla de utilidad para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    // Regla para verificar si el usuario es dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Perfiles de usuario
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Habilidades y Scores (el "CORE" / DNA técnico).
    // ✅ INTEGRIDAD (B2): el DNA es de SOLO LECTURA para el cliente. La escritura ocurre
    // únicamente en servidor con el Admin SDK (POST /api/line/submit), que bypassa estas reglas.
    // Así el usuario no puede falsificar su propio DNA desde el navegador.
    match /user_skill_scores/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Roadmaps personalizados
    match /user_roadmaps/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Intentos de evaluación.
    // Lectura SOLO del dueño (una query de lista debe filtrar por `userId`). La creación ocurre
    // solo en servidor (Admin SDK); el cliente no crea intentos.
    match /assessment_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Sesiones de "The LINE" y claves de respuestas de vacantes: SERVER-ONLY.
    // Contienen `correctIndex`; el cliente nunca debe leerlas ni escribirlas.
    // El Admin SDK bypassa estas reglas.
    match /line_sessions/{sessionId} {
      allow read, write: if false;
    }
    match /job_answer_keys/{jobId} {
      allow read, write: if false;
    }

    // Repertorios de preguntas de las simulaciones generales (uno por especialidad_nivel).
    // Mismo motivo que los anteriores: contienen `correctIndex`. SERVER-ONLY.
    match /line_question_pools/{poolId} {
      allow read, write: if false;
    }

    // Trabajos / Vacantes.
    // Lectura pública. Escritura solo del reclutador DUEÑO (`createdBy`), sin borrado desde
    // cliente y sin poder reasignar la propiedad. Esto desbloquea la creación de vacantes y su
    // actualización con la prueba generada por IA. (docs/TECH_DEBT B1)
    match /jobs/{jobId} {
      allow read: if true;
      allow list: if true;
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // El estado del repertorio y el contador de candidatos los escribe SOLO el servidor: el dueño
      // edita la vacante, pero no puede marcar su prueba como lista ni inflar sus candidatos.
      allow update: if isAuthenticated()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['assessmentReady', 'assessmentPoolSize', 'assessmentMissingSkills', 'applicantsCount']);
      allow delete: if false;
    }

    // Banco curado de preguntas (`BankQuestion`). SERVER-ONLY.
    // ⚠️ Antes era `read: if isAuthenticated()`. Estos documentos incluyen `correctIndex`, así que
    // cualquier usuario logueado podía leer la clave de respuestas y aprobar cualquier prueba —
    // exactamente lo que invalida el "DNA verificado". El único consumidor es
    // `sampleBankQuestions` (`src/lib/server/question-bank.ts`), que usa el Admin SDK y bypassa
    // estas reglas, así que cerrarlo no rompe nada.
    match /questions/{qId} {
      allow read, write: if false;
    }

    // Match de candidatos (Engine). Escritura solo vía servidor/Admin.
    match /candidate_matches/{matchId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.recruiterId == request.auth.uid);
      allow write: if false; // Solo vía Admin/Server
    }

    // Evidencia de GitHub (Engine determinístico + Mistral).
    // Lectura del dueño autenticado, escritura SERVER-ONLY vía Admin SDK.
    match /github_evidence/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Evidencia POR REPOSITORIO del análisis multi-repo (github_evidence/{uid}/repos/{repoId}).
    // Una regla de documento no cubre sus subcolecciones: sin este bloque el dueño no podría leer
    // el detalle de sus propios repositorios. Escritura server-only, igual que el perfil agregado.
    match /github_evidence/{userId}/repos/{repoId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Tokens OAuth de GitHub cifrados (github_tokens/{uid}). SERVER-ONLY.
    // Almacena tokens de acceso de GitHub cifrados con AES-256-GCM para análisis por usuario.
    // El cliente nunca lee ni escribe: solo el Admin SDK (route handlers).
    match /github_tokens/{userId} {
      allow read: if false;
      allow write: if false;
    }

    // Contadores de límite de peticiones por usuario (src/lib/server/rate-limit.ts). SERVER-ONLY:
    // si el cliente pudiera escribirlos, reiniciaría su propio límite.
    match /api_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // Catálogo curado de skills del Roadmap Determinístico.
    // Lectura pública (usuario autenticado). Escritura SERVER-ONLY via Admin SDK
    // (script seed:catalog o futuro endpoint de administración).
    match /skill_catalog/{skillId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Rutas de progresión curadas del Roadmap Determinístico.
    // Mismo patrón que skill_catalog: lectura autenticada, escritura server-only.
    match /roadmap_routes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}

