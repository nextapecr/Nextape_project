# =============================================================================
# NEXTAPE — Variables de entorno (plantilla)
# Copia este archivo a `.env` (o `.env.local`) y rellena los valores.
# `.env*` está en .gitignore: NUNCA commitees el archivo real.
# =============================================================================

# --- Firebase Web config (PÚBLICO; se expone al cliente con NEXT_PUBLIC_) ---
# Si se dejan vacías, la app usa los valores por defecto en src/lib/firebase/client.ts.
# ⚠️ Definir el proyecto canónico (ver docs/TECH_DEBT.md B3: hoy client.ts usa
#    `studio-4462619429-470d8` y `.firebaserc` usa `nextape-prod`).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Groq / IA (SECRETO; SOLO servidor, sin prefijo NEXT_PUBLIC) ---
# Proveedor de IA del proyecto (modelos open-source tipo Llama). Requerido por los flows de
# Genkit en src/ai/*. En Netlify va como variable de entorno (Functions). Ver docs/SECURITY.md.
# Consíguela en https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: sobreescribe el modelo por defecto (groq/llama-3.3-70b-versatile).
# GROQ_MODEL=groq/llama-3.1-8b-instant

# --- Firebase Admin SDK (SECRETO; SOLO servidor — route handlers /api/*) ---
# Necesario para el scoring server-trust (escribir el DNA sin que el cliente pueda falsificarlo).
# En Netlify NO hay ADC: define FIREBASE_SERVICE_ACCOUNT con el JSON completo del service account.
# (En Google Cloud sí existe ADC; en local puedes usar GOOGLE_APPLICATION_CREDENTIALS.)
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=

# --- ALTERNATIVA al JSON completo (recomendada en paneles web de hosting) ---
# Las tres juntas sustituyen a FIREBASE_SERVICE_ACCOUNT. Son mucho menos frágiles: el JSON de
# ~2400 caracteres con \n incrustados se corrompe con facilidad al pegarlo en un panel, y el
# síntoma es un 401 en TODOS los /api/*, que no se parece en nada a la causa.
# La clave privada se acepta con los \n escapados (tal cual los guarda el panel) o reales.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- The LINE (OPCIONAL) ---
# Horas entre intentos de una misma tecnología o vacante. Por defecto 24. Pon 0 SOLO en local para
# probar sin esperar; en producción no la definas.
# LINE_ATTEMPT_COOLDOWN_HOURS=24
