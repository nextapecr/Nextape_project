# =============================================================================
# NEXTAPE — Variables de entorno (plantilla)
# Copia este archivo a `.env.local` y rellena los valores.
# `.env*` está en .gitignore: NUNCA commitees el archivo real.
#
# En producción (Netlify) cada variable va en Site settings → Environment variables.
# Leyenda: [OBLIGATORIA] sin ella algo deja de funcionar · [OPCIONAL] tiene un valor por defecto.
# =============================================================================

# --- Firebase Web config (PÚBLICO; se expone al cliente con NEXT_PUBLIC_) --- [OPCIONAL]
# Si se dejan vacías, la app usa los valores por defecto de src/lib/firebase/client.ts, que apuntan al
# proyecto canónico `studio-4462619429-470d8` (el mismo de `.firebaserc`).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SECRETO; SOLO servidor — route handlers /api/*) --- [OBLIGATORIA]
# Sin esto TODOS los /api/* responden 401/500: corrección de The LINE, DNA, vacantes y GitHub.
# En Netlify NO hay ADC: define FIREBASE_SERVICE_ACCOUNT con el JSON completo del service account.
# (En Google Cloud sí existe ADC; en local puedes usar GOOGLE_APPLICATION_CREDENTIALS.)
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=

# ALTERNATIVA al JSON completo (recomendada en paneles web de hosting):
# las tres juntas sustituyen a FIREBASE_SERVICE_ACCOUNT. Son mucho menos frágiles: el JSON de
# ~2400 caracteres con \n incrustados se corrompe con facilidad al pegarlo en un panel, y el
# síntoma es un 401 en TODOS los /api/*, que no se parece en nada a la causa.
# La clave privada se acepta con los \n escapados (tal cual los guarda el panel) o reales.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- IA: Groq (SECRETO; SOLO servidor) --- [OBLIGATORIA para la IA]
# Único proveedor de IA del proyecto. Se usa para:
#   - generar el banco de preguntas de The LINE (script `npm run seed:questions`, NO en runtime);
#   - el feedback en texto del análisis de GitHub (`/api/github/aggregate`).
# Sin ella el feedback de GitHub cae a un texto determinístico; The LINE sigue funcionando con el
# banco ya cargado. Consíguela en https://console.groq.com/keys
GROQ_API_KEY=
# [OPCIONAL] Modelo. Por defecto groq/openai/gpt-oss-120b, con fallback automático a
# groq/openai/gpt-oss-20b (ver src/ai/genkit.ts y src/ai/generate.ts).
# GROQ_MODEL=groq/openai/gpt-oss-120b

# --- GitHub OAuth: cifrado de tokens (SECRETO; SOLO servidor) --- [OBLIGATORIA para GitHub]
# Clave AES-256-GCM con la que se cifran los tokens OAuth de GitHub de cada usuario antes de
# guardarlos en `github_tokens/{uid}`. Sin ella, "Conectar GitHub" devuelve 500.
# Genera una con:  openssl rand -hex 32   (64 caracteres hexadecimales)
# ⚠️ Si la cambias, los tokens ya guardados dejan de poder descifrarse: los usuarios tendrán que
#    volver a conectar GitHub.
TOKEN_ENCRYPTION_KEY=

# --- GitHub OAuth App (SECRETO; SOLO servidor) --- [OPCIONAL, recomendada]
# Las credenciales de la OAuth App de GitHub configurada en Firebase Auth (proveedor github.com).
# Solo se usan al DESCONECTAR GitHub (`/api/github/oauth/revoke`) para revocar el token también en
# GitHub. Sin ellas, el token se borra de la base de datos pero sigue siendo válido en GitHub hasta
# que el usuario lo revoque a mano.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- The LINE --- [OPCIONAL]
# Horas entre intentos de una misma tecnología o vacante. Por defecto 24. Pon 0 SOLO en local para
# probar sin esperar; en producción no la definas.
# LINE_ATTEMPT_COOLDOWN_HOURS=24

# --- Motor de GitHub (tree-sitter) --- [OPCIONAL]
# Carpeta donde se cachean las gramáticas de tree-sitter. Por defecto, el directorio temporal del
# sistema. Útil si el hosting solo permite escribir en una ruta concreta.
# TREE_SITTER_CACHE_DIR=

# -----------------------------------------------------------------------------
# YA NO SE USAN (no las definas; se listan para que nadie las busque):
#   GITHUB_TOKEN      → reemplazado por OAuth por usuario (token cifrado en github_tokens/{uid}).
#   NVIDIA_API_KEY    → nunca llegó a implementarse en el código.
#   MISTRAL_API_KEY   → solo la lee src/ai/mistral.ts, que ningún archivo importa (código muerto).
#   GEMINI_API_KEY    → el proyecto ya no usa Gemini.
# -----------------------------------------------------------------------------
